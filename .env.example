# Database configuration
DATABASE_URL=postgres://user:password@localhost:5432/dbname?sslmode=disable
PORT=8080
MIGRATIONS_PATH=file://migrations

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Default Admin Account
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123

# Development settings
GIN_MODE=debug

COMMON_HOST=localhost
FRONTEND_HOSTS=localhost:3000

# Cap CAPTCHA verification
CAP_URL=
CAP_SECRET=

# OpenTelemetry configuration (Phase 0 + 1)
# Service name used in traces/metrics resources.
OTEL_SERVICE_NAME=cardtalogue-backend

# OTLP collector / Grafana endpoint. For Grafana Cloud or a local collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Protocol: "http/protobuf" (default) or "grpc" (grpc exporter unavailable here).
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Trace exporter: "otlp" | "stdout" | "none".
OTEL_TRACES_EXPORTER=otlp

# Metrics exporter: "otlp" | "stdout" | "none".
OTEL_METRICS_EXPORTER=otlp

# Address/port for the local Prometheus /metrics endpoint served by the API.
OTEL_METRICS_ADDRESS=0.0.0.0
OTEL_METRICS_PORT=9090

# Resource attributes (k1=v1;k2=v2). deployment.environment is added automatically.
OTEL_RESOURCE_ATTRIBUTES=service.version=0.1.0

# Batch span/metric processor tuning (milliseconds / counts).
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
